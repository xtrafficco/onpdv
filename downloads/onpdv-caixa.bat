@echo off
setlocal EnableExtensions
title Instalador ONPDV Caixa

set "ONPDV_HOME=%LOCALAPPDATA%\ONPDV\PDV"
set "ONPDV_TMP=%TEMP%\onpdv-caixa-install"
set "ONPDV_ZIP=%ONPDV_TMP%\onpdv-caixa-pdv.zip"
set "ONPDV_RELEASE=2026.09.08-v55"
set "NODE_VERSION=22.23.1"
set "NODE_ARCH=win-x64"
if /I "%PROCESSOR_ARCHITECTURE%"=="ARM64" set "NODE_ARCH=win-arm64"
set "NODE_ZIP=%ONPDV_TMP%\node.zip"
set "NODE_URL=https://nodejs.org/dist/v%NODE_VERSION%/node-v%NODE_VERSION%-%NODE_ARCH%.zip"

echo.
echo ========================================
echo       INSTALADOR ONPDV CAIXA
echo ========================================
echo Versao %ONPDV_RELEASE%
echo.
echo Instalando em:
echo %ONPDV_HOME%
echo.

if exist "%ONPDV_TMP%" rmdir /s /q "%ONPDV_TMP%"
mkdir "%ONPDV_TMP%" >nul 2>nul
mkdir "%ONPDV_HOME%" >nul 2>nul

echo [1/4] Preparando arquivos do ONPDV...
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command ^
  "$raw=[IO.File]::ReadAllText('%~f0'); $mark='::ONPDV_BUNDLE_BASE64::'; $p=$raw.LastIndexOf($mark); if($p -lt 0){exit 1}; $b64=($raw.Substring($p+$mark.Length) -replace '\s',''); [IO.File]::WriteAllBytes('%ONPDV_ZIP%',[Convert]::FromBase64String($b64))"
if errorlevel 1 goto :download_error

echo [2/4] Atualizando o aplicativo...
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command ^
  "Expand-Archive -LiteralPath '%ONPDV_ZIP%' -DestinationPath '%ONPDV_HOME%' -Force"
if errorlevel 1 goto :install_error

if not exist "%ONPDV_HOME%\runtime\node.exe" (
  echo [3/4] Preparando o componente local...
  powershell.exe -NoProfile -ExecutionPolicy Bypass -Command ^
    "$ProgressPreference='SilentlyContinue'; Invoke-WebRequest -UseBasicParsing -Uri '%NODE_URL%' -OutFile '%NODE_ZIP%'; $d='%ONPDV_TMP%\node'; Expand-Archive -LiteralPath '%NODE_ZIP%' -DestinationPath $d -Force; $s=Get-ChildItem -LiteralPath $d -Directory | Select-Object -First 1; New-Item -ItemType Directory -Path '%ONPDV_HOME%\runtime' -Force | Out-Null; Copy-Item -Path ($s.FullName+'\*') -Destination '%ONPDV_HOME%\runtime' -Recurse -Force"
  if errorlevel 1 goto :node_error
) else (
  echo [3/4] Componente local ja instalado.
)

echo [4/4] Criando atalho na Area de Trabalho...
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command ^
  "$desktop=[Environment]::GetFolderPath('Desktop'); $w=New-Object -ComObject WScript.Shell; $s=$w.CreateShortcut((Join-Path $desktop 'ONPDV Caixa.lnk')); $s.TargetPath='%ONPDV_HOME%\onpdv-caixa.bat'; $s.WorkingDirectory='%ONPDV_HOME%'; $s.IconLocation='%ONPDV_HOME%\onpdv-caixa.ico,0'; $s.Description='ONPDV - Frente de Caixa'; $s.Save()"

echo.
echo Instalacao concluida. Abrindo o ONPDV Caixa...
start "" "%ONPDV_HOME%\onpdv-caixa.bat"
timeout /t 3 /nobreak >nul
exit /b 0

:download_error
echo.
echo O pacote interno do ONPDV esta incompleto.
echo Baixe novamente pelo Backoffice.
pause
exit /b 1

:install_error
echo.
echo Nao foi possivel extrair os arquivos do ONPDV.
pause
exit /b 1

:node_error
echo.
echo Nao foi possivel preparar o componente local.
echo Verifique a internet e tente novamente.
pause
exit /b 1

